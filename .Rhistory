dplyr::distinct() %>%
left_join(post_feat_df %>% dplyr::select(prolific_id, z_mean), by = "prolific_id") %>%
filter(!is.na(z_mean))
cat("\nTrial", s, ":\n")
for (f in feats_s) {
ct <- cor.test(snap_df[[f]], snap_df$z_mean)
cat(" ", f, "| r =", round(ct$estimate, 3), "| p =", round(ct$p.value, 4), "\n")
}
snap_results[[as.character(s)]] <- snap_df
}
# ── regression — average features predict posttest ────────────────────────────
cat("\n--- Regression: Average Features -> Posttest ---\n")
lm(z_mean ~ mean_color + mean_colorcomp + mean_shape +
mean_sideangle + mean_sidecomp + mean_spatial,
data = post_feat_df) %>% summary()
# surface vs relational
cat("\n--- Surface vs Relational -> Posttest ---\n")
cor.test(post_feat_df$mean_surface,    post_feat_df$z_mean)
cor.test(post_feat_df$mean_relational, post_feat_df$z_mean)
lm(z_mean ~ mean_surface + mean_relational, data = post_feat_df) %>% summary()
# ── trajectory of feature use across snapshots ────────────────────────────────
# relational shift score: trial 20 - trial 5
post_feat_df <- post_feat_df %>%
dplyr::mutate(
relational_shift = relational20 - mean(c(
master_df$RelationalCount5[match(prolific_id, master_df$prolific_id)]), na.rm = TRUE),
surface_shift    = surface20 - mean(c(
master_df$SurfaceCount5[match(prolific_id, master_df$prolific_id)]), na.rm = TRUE)
)
# ── trajectory of feature use across snapshots ────────────────────────────────
# relational shift score: trial 20 - trial 5
post_feat_df <- post_feat_df %>%
dplyr::mutate(
relational_shift = relational20 - mean(c(
master_df$RelationalCount5[match(prolific_id, master_df$prolific_id)]), na.rm = TRUE),
surface_shift    = surface20 - mean(c(
master_df$SurfaceCount5[match(prolific_id, master_df$prolific_id)]), na.rm = TRUE)
)
# ── trajectory of feature use across snapshots ────────────────────────────────
# relational shift score: trial 20 - trial 5
post_feat_df <- post_feat_df %>%
left_join(
master_df %>%
dplyr::select(prolific_id, RelationalCount5, SurfaceCount5,
RelationalCount20, SurfaceCount20) %>%
dplyr::distinct(),
by = "prolific_id"
) %>%
dplyr::mutate(
relational_shift = RelationalCount20 - RelationalCount5,
surface_shift    = SurfaceCount20    - SurfaceCount5
)
cor.test(post_feat_df$relational_shift, post_feat_df$z_mean)
cor.test(post_feat_df$surface_shift,    post_feat_df$z_mean)
ggplot(post_feat_df %>% filter(is.finite(relational_shift)),
aes(x = relational_shift, y = z_mean)) +
geom_point(alpha = 0.6, color = "#b8a5d9") +
geom_smooth(method = "lm", se = TRUE, color = "#b8a5d9") +
theme_minimal(base_size = 13) +
labs(title = "Relational Feature Shift (Trial 5 → 20) vs Posttest",
x = "Relational Shift (trial 20 - trial 5)",
y = "Posttest Accuracy (z-scored)")
# ── regression — average features predict posttest ────────────────────────────
cat("\n--- Regression: Average Features -> Posttest ---\n")
lm(z_mean ~ mean_color + mean_colorcomp + mean_shape +
mean_sideangle + mean_sidecomp + mean_spatial,
data = post_feat_df) %>% summary()
# surface vs relational
cat("\n--- Surface vs Relational -> Posttest ---\n")
cor.test(post_feat_df$mean_surface,    post_feat_df$z_mean)
cor.test(post_feat_df$mean_relational, post_feat_df$z_mean)
lm(z_mean ~ mean_surface + mean_relational, data = post_feat_df) %>% summary()
for (s in c(5, 10, 15, 20)) {
cat("\n--- Trial", s, "Regression ---\n")
snap_df <- snap_results[[as.character(s)]]
lm(z_mean ~ ., data = snap_df %>%
dplyr::select(z_mean, all_of(paste0(c("Color","ColorComp","Shape",
"SideAngle","SideComp","Spatial"), s)))) %>%
summary() %>% print()
}
# ── correlations — trial 20 features vs posttest ──────────────────────────────
last_features <- c("color20", "colorcomp20", "shape20",
"sideangle20", "sidecomp20", "spatial20")
feat_sub_df <- feat_sub_df %>%
dplyr::mutate(across(-prolific_id, as.numeric))
# pull trial 20 columns from master_df and join onto post_feat_df
trial20_cols <- master_df %>%
dplyr::select(prolific_id, Color20, ColorComp20, Shape20,
SideAngle20, SideComp20, Spatial20) %>%
dplyr::rename(
color20     = Color20,
colorcomp20 = ColorComp20,
shape20     = Shape20,
sideangle20 = SideAngle20,
sidecomp20  = SideComp20,
spatial20   = Spatial20
) %>%
dplyr::mutate(across(-prolific_id, as.numeric))
post_feat_df <- post_feat_df %>%
left_join(trial20_cols, by = "prolific_id")
cat("\n--- Trial 20 Feature Use vs Posttest ---\n")
cor_results_20 <- sapply(last_features, function(f) {
ct <- cor.test(post_feat_df[[f]], post_feat_df$z_mean)
c(r = ct$estimate, p = ct$p.value)
})
# ── correlations — each snapshot separately vs posttest ───────────────────────
cat("\n--- Feature Use at Each Snapshot vs Posttest ---\n")
snapshots <- c(5, 10, 15, 20)
snap_results <- list()
for (s in snapshots) {
feats_s <- paste0(c("Color", "ColorComp", "Shape", "SideAngle", "SideComp", "Spatial"), s)
snap_df <- master_df %>%
dplyr::select(prolific_id, all_of(feats_s)) %>%
dplyr::distinct() %>%
left_join(post_feat_df %>% dplyr::select(prolific_id, z_mean), by = "prolific_id") %>%
filter(!is.na(z_mean))
cat("\nTrial", s, ":\n")
for (f in feats_s) {
ct <- cor.test(snap_df[[f]], snap_df$z_mean)
cat(" ", f, "| r =", round(ct$estimate, 3), "| p =", signif(ct$p.value, 3), "\n")
}
snap_results[[as.character(s)]] <- snap_df
}
library(ggplot2)
library(reshape2)
cor_matrix <- data.frame(
Feature  = c("Color", "ColorComp", "Shape", "SideAngle", "SideComp", "Spatial"),
Trial_5  = c(0.027,  0.032, -0.024, 0.187, 0.214, 0.089),
Trial_10 = c(0.142,  0.207,  0.113, 0.330, 0.427, 0.166),
Trial_15 = c(0.215,  0.231,  0.153, 0.390, 0.463, 0.290),
Trial_20 = c(0.263,  0.341,  0.105, 0.316, 0.426, 0.299)
)
# significance markers
sig_matrix <- data.frame(
Feature  = c("Color", "ColorComp", "Shape", "SideAngle", "SideComp", "Spatial"),
Trial_5  = c("",   "",    "",   "**", "**",  ""),
Trial_10 = c("*",  "**",  "",   "***","***", "*"),
Trial_15 = c("**", "**",  "*",  "***","***", "***"),
Trial_20 = c("***","***", "",   "***","***", "***")
)
# melt both
cor_long <- melt(cor_matrix, id.vars = "Feature",
variable.name = "Trial", value.name = "r")
sig_long  <- melt(sig_matrix, id.vars = "Feature",
variable.name = "Trial", value.name = "sig")
cor_long$sig <- sig_long$sig
# order features by mean r
feature_order <- cor_matrix %>%
dplyr::mutate(mean_r = rowMeans(dplyr::select(., -Feature))) %>%
dplyr::arrange(mean_r) %>%
dplyr::pull(Feature)
cor_long$Feature <- factor(cor_long$Feature, levels = feature_order)
cor_long$Trial   <- factor(cor_long$Trial,
levels = c("Trial_5","Trial_10","Trial_15","Trial_20"),
labels = c("Trial 5","Trial 10","Trial 15","Trial 20"))
ggplot(cor_long, aes(x = Trial, y = Feature, fill = r)) +
geom_tile(color = "white", linewidth = 0.5) +
geom_text(aes(label = paste0(round(r, 2), sig)),
size = 4, color = "white") +
scale_fill_gradient2(low = "#f0e6ff", mid = "#b8a5d9", high = "#5a3d8a",
midpoint = 0.25, limits = c(-0.05, 0.5),
name = "Pearson r") +
theme_minimal(base_size = 13) +
labs(title = "Feature–Posttest Correlations Across Training Snapshots",
x = "", y = "") +
theme(axis.text.x = element_text(angle = 0, hjust = 0.5),
panel.grid   = element_blank())
# build from snap_results directly
cor_long <- purrr::map_dfr(names(snap_results), function(s) {
snap_df <- snap_results[[s]]
feats_s <- paste0(c("Color", "ColorComp", "Shape", "SideAngle", "SideComp", "Spatial"), s)
purrr::map_dfr(feats_s, function(f) {
ct <- cor.test(snap_df[[f]], snap_df$z_mean)
data.frame(
Feature = gsub(s, "", f),  # strip the number suffix
Trial   = paste("Trial", s),
r       = ct$estimate,
p       = ct$p.value
)
})
})
# add significance stars
cor_long <- cor_long %>%
dplyr::mutate(
sig = dplyr::case_when(
p < 0.001 ~ "***",
p < 0.01  ~ "**",
p < 0.05  ~ "*",
TRUE      ~ ""
),
Trial   = factor(Trial, levels = paste("Trial", c(5, 10, 15, 20))),
Feature = factor(Feature, levels = cor_long %>%
dplyr::group_by(Feature) %>%
dplyr::summarise(mean_r = mean(r)) %>%
dplyr::arrange(mean_r) %>%
dplyr::pull(Feature) %>% unique())
)
ggplot(cor_long, aes(x = Trial, y = Feature, fill = r)) +
geom_tile(color = "white", linewidth = 0.5) +
geom_text(aes(label = paste0(round(r, 2), sig)),
size = 4, color = "white") +
scale_fill_gradient2(low = "#f0e6ff", mid = "#b8a5d9", high = "#5a3d8a",
midpoint = 0.25, limits = c(-0.05, 0.5),
name = "Pearson r") +
theme_minimal(base_size = 13) +
labs(title = "Feature–Posttest Correlations Across Training Snapshots",
x = "", y = "") +
theme(panel.grid = element_blank())
