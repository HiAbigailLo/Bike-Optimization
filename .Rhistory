# build a long dataframe of relational counts per person per snapshot
relational_long <- purrr::map_dfr(c(5, 10, 15, 20), function(s) {
master_df %>%
dplyr::select(prolific_id, all_of(paste0("RelationalCount", s))) %>%
dplyr::rename(relational = paste0("RelationalCount", s)) %>%
dplyr::mutate(trial = s)
})
# fit a slope per person
relational_slopes <- relational_long %>%
dplyr::group_by(prolific_id) %>%
dplyr::summarise(
relational_slope = coef(lm(relational ~ trial))[["trial"]],
.groups = "drop"
)
# build a long dataframe of relational counts per person per snapshot
relational_long <- purrr::map_dfr(c(5, 10, 15, 20), function(s) {
master_df %>%
dplyr::select(prolific_id, all_of(paste0("RelationalCount", s))) %>%
dplyr::rename(relational = paste0("RelationalCount", s)) %>%
dplyr::mutate(trial = s)
})
# fit a slope per person
relational_slopes <- relational_long %>%
dplyr::group_by(prolific_id) %>%
dplyr::filter(sum(!is.na(relational)) >= 2) %>%
dplyr::summarise(
relational_slope = coef(lm(relational ~ trial, na.action = na.omit))[["trial"]],
.groups = "drop"
)
# join onto post_feat_df and correlate
post_feat_df <- post_feat_df %>%
left_join(relational_slopes, by = "prolific_id")
cor.test(post_feat_df$relational_slope, post_feat_df$z_mean)
ggplot(post_feat_df, aes(x = relational_slope, y = z_mean)) +
geom_point(alpha = 0.6, color = "#b8a5d9") +
geom_smooth(method = "lm", se = TRUE, color = "#b8a5d9") +
theme_minimal(base_size = 13) +
labs(title = "Relational Feature Growth Slope vs Posttest",
x = "Relational Slope (across trials 5–20)",
y = "Posttest Accuracy (z-scored)")
